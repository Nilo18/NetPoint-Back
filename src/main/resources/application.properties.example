server.port=8081
spring.application.name=NetPoint

# 1. THE URL: Using the Sydney Region Pooler
# I added ?prepareThreshold=0 which is REQUIRED for port 6543
spring.datasource.url=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?prepareThreshold=0

# 2. THE USERNAME: This is exactly what the dashboard gave you
spring.datasource.username=postgres.sdgucpokmnuxoyhjsazi

# 3. THE PASSWORD: Your database password
spring.datasource.password=REPLACE_ME

# 4. ESSENTIAL DRIVER SETTINGS
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# 5. CONNECTION TIMEOUT
spring.datasource.hikari.connection-timeout=30000